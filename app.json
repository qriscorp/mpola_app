{
  "expo": {
    "name": "Mpola",
    "slug": "mpola-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mpola_logo-3.png",
    "scheme": "mpola",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/mpola_logo-1.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B2B3A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mpola.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mpola_logo-3.png",
        "backgroundColor": "#1B2B3A"
      },
      "package": "com.mpola.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/mpola_logo-3.png"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
